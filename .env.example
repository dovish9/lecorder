# Copy to .env, or edit these paths from the dashboard.
# Relative paths are resolved from the Lecorder project root.
LECORDER_DIR=.
LECORDER_OUTPUT_DIR=output

# Unload the locally managed Whisper model after 60 idle seconds.
WHISPER_IDLE_SECONDS=60

# OCR engine: vision (macOS helper) or tesseract (kor+eng language packs).
LECORDER_OCR_ENGINE=vision

# AI 제공자·모델·URL은 환경설정에서 관리합니다. API 키는 macOS Keychain에 저장합니다.
