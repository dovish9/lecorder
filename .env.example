# Lecorder 환경설정 — 상대 경로는 프로젝트 폴더 기준입니다.
# 변경 후 서버를 재시작하세요. 화면에서 저장한 AI·경로 설정도 여기에 반영됩니다.
# 빈 파일 경로는 기본 설치 경로를 자동으로 사용합니다.
# API 키를 비우면 보안 저장소를 사용합니다. 실제 키는 .env.example에 넣지 마세요.

# ── 앱과 저장 경로 (상대 경로는 프로젝트 기준) ──
# 시작할 환경설정 파일. 다른 환경을 쓰려면 실행 전에 지정
LECORDER_ENV_FILE=.env
# 프로젝트 폴더
LECORDER_DIR=.
# 원본 음성과 Markdown 결과 폴더
LECORDER_OUTPUT_DIR=outputs
# DB·녹음 조각·노트·실행 로그 폴더
LECORDER_DATA_DIR=web/data
# AI 설정 JSON 저장 파일. 비우면 DATA_DIR/ai-settings.json
LECORDER_AI_SETTINGS=''
# 로컬 도구·모델·토크나이저 폴더
LECORDER_DEPENDENCIES_DIR=dependencies
# 1이면 start.command가 브라우저를 자동으로 열지 않음
LECORDER_NO_BROWSER=0
# 대시보드 포트 (로컬 연결)
LECORDER_PORT=5055

# ── 설치와 빌드 ──
# pyenv에서 사용할 Python minor 버전 (3.11 이상)
LECORDER_PYTHON_VERSION=3.13
# 네이티브 도구 빌드 병렬 작업 수
LECORDER_BUILD_JOBS=4
# llama.cpp 실제 소스 폴더. 비우면 기존 링크 또는 ~/Local Storage/llama.cpp
LECORDER_LLAMA_DIR=''

# ── 최종 음성 변환 ──
# whisper_cpp / openai
LECORDER_SPEECH_PROVIDER=whisper_cpp
# 앱이 로컬 서버 시작·종료 관리
LECORDER_SPEECH_MANAGED=true
# 서버 URL
LECORDER_SPEECH_BASE_URL=http://127.0.0.1:8080
# 외부 OpenAI 음성 변환은 whisper-1
LECORDER_SPEECH_MODEL=large-v3
# 비우면 dependencies의 whisper-server
LECORDER_SPEECH_BINARY=''
# 비우면 기본 large-v3 모델
LECORDER_SPEECH_MODEL_PATH=''
# 비우면 기본 Silero 모델
LECORDER_SPEECH_VAD_PATH=''
# Whisper CPU 스레드 수. 0이면 서버 기본값
LECORDER_SPEECH_THREADS=0
# 로컬 음성 모델 유휴 해제 시간
WHISPER_IDLE_SECONDS=60

# ── 실시간 음성 변환 (로컬 자동 관리, 실행 파일은 최종 음성과 공유) ──
# 최종 음성·LLM과 다른 포트
LECORDER_LIVE_BASE_URL=http://127.0.0.1:8082
# 실시간 모델 ID
LECORDER_LIVE_MODEL=large-v3-turbo
# 비우면 기본 turbo 모델
LECORDER_LIVE_MODEL_PATH=''
# 비우면 기본 Silero 모델
LECORDER_LIVE_VAD_PATH=''
# 미처리 PCM 최대 보관 시간
LECORDER_LIVE_BUFFER_SECONDS=60
# 일반 발화 최소 누적 시간
LECORDER_LIVE_MIN_SECONDS=3.0
# 연속 발화 최대 구간
LECORDER_LIVE_MAX_SECONDS=20.0
# 발화 종료 무음
LECORDER_LIVE_SILENCE_SECONDS=0.7
# 짧은 발화 종료 무음
LECORDER_LIVE_SHORT_SILENCE_SECONDS=2.0
# 발화 앞뒤 여유
LECORDER_LIVE_PADDING_SECONDS=0.2
# 최대 길이 절단 시 겹침
LECORDER_LIVE_OVERLAP_SECONDS=1.0
# 발화 확률 임계값
LECORDER_LIVE_VAD_THRESHOLD=0.5
# 브라우저 생존 신호 만료 시간
LECORDER_LIVE_HEARTBEAT_SECONDS=30.0
# 실시간 음성 변환 요청 제한 시간
LECORDER_LIVE_REQUEST_SECONDS=45.0
# VAD 요청 제한 시간
LECORDER_LIVE_VAD_TIMEOUT_SECONDS=10.0

# ── LLM 제공자와 로컬 서버 ──
# llama_cpp / openai / claude / gemini
LECORDER_LLM_PROVIDER=llama_cpp
# 앱이 로컬 서버 관리
LECORDER_LLM_MANAGED=true
# 서버 URL
LECORDER_LLM_BASE_URL=http://127.0.0.1:8081
# LLM 모델 ID
LECORDER_LLM_MODEL=Qwen3.5-9B
# 비우면 dependencies의 llama-server
LECORDER_LLM_BINARY=''
# 비우면 기본 Qwen GGUF
LECORDER_LLM_MODEL_PATH=''
# 비우면 기본 이미지 projector
LECORDER_LLM_PROJECTOR_PATH=''
# LLM 유휴 해제 시간
LECORDER_LLM_IDLE_SECONDS=60
# 로컬 모델 컨텍스트. 늘리면 메모리 사용 증가
LECORDER_LLM_CONTEXT_TOKENS=16384
# LLM CPU 스레드 수. 0이면 서버 기본값
LECORDER_LLM_THREADS=0
# GPU로 올릴 레이어 수
LECORDER_LLM_GPU_LAYERS=99
# 프롬프트 처리 배치
LECORDER_LLM_BATCH_SIZE=512
# 물리 마이크로 배치
LECORDER_LLM_UBATCH_SIZE=128

# ── 외부 API 키 (선택, 비우면 운영체제 보안 저장소 사용) ──
# 외부 음성 API 키. 실제 키를 예제 파일에 넣지 마세요
LECORDER_SPEECH_API_KEY=''
# 선택한 LLM 제공자의 API 키
LECORDER_LLM_API_KEY=''

# ── 연결·모델 수명주기 ──
# 일반 AI 요청 제한 시간
LECORDER_AI_REQUEST_SECONDS=600.0
# 로컬 모델 로드 제한 시간
LECORDER_MODEL_LOAD_SECONDS=180.0
# 정상 종료 대기 시간
LECORDER_MODEL_STOP_SECONDS=5.0
# 일시적인 API 오류의 최대 재시도 횟수
LECORDER_AI_RETRIES=1
# API 재시도 전 대기 시간
LECORDER_AI_RETRY_DELAY_SECONDS=1.0
# 설정 저장 전 연결 검증 제한 시간
LECORDER_SETTINGS_CHECK_SECONDS=55.0

# ── 음성 변환 구간·인식 힌트·품질 재시도 ──
# 최종 음성 변환 목표 구간 길이
LECORDER_SPEECH_CHUNK_SECONDS=120.0
# 목표 경계 주변 무음 탐색
LECORDER_SPEECH_CUT_SEARCH_SECONDS=12.0
# 무음 경계가 없을 때 앞뒤 겹침
LECORDER_SPEECH_OVERLAP_SECONDS=2.0
# 인식 힌트 토큰 상한
LECORDER_HINT_MAX_TOKENS=96
# 저신뢰 음성 변환 기준 log probability
LECORDER_SPEECH_LOW_CONFIDENCE=-0.65
# 품질 재변환 최대 묶음 수
LECORDER_SPEECH_RETRY_MAX_GROUPS=4
# 품질 재변환 음성 시간 예산
LECORDER_SPEECH_RETRY_MAX_SECONDS=90.0
# 초기 디코딩 온도
LECORDER_SPEECH_TEMPERATURE=0.0
# Whisper 온도 증가량
LECORDER_SPEECH_TEMPERATURE_INC=0.2
# Whisper 엔트로피 임계값
LECORDER_SPEECH_ENTROPY_THRESHOLD=2.8
# Whisper 디코딩 log probability 임계값
LECORDER_SPEECH_LOGPROB_THRESHOLD=-1.0
# 무음 판정 확률 임계값
LECORDER_SPEECH_NO_SPEECH_THRESHOLD=0.6
# Whisper 세그먼트 텍스트 최대 길이
LECORDER_SPEECH_MAX_LENGTH=240
# Whisper 디코더 문맥 토큰 상한
LECORDER_SPEECH_MAX_CONTEXT=224
# 빔 탐색 크기, -1은 서버 기본값
LECORDER_SPEECH_BEAM_SIZE=-1
# Whisper 디코딩 후보 수
LECORDER_SPEECH_BEST_OF=2
# VAD 구간 겹침
LECORDER_SPEECH_VAD_OVERLAP=0.2
# 저신뢰 재변환 빔 탐색 크기
LECORDER_SPEECH_RETRY_BEAM_SIZE=5
# 최종 음성 VAD 임계값
LECORDER_SPEECH_VAD_THRESHOLD=0.5
# 최소 발화 길이
LECORDER_SPEECH_VAD_MIN_SPEECH_MS=250
# 최소 무음 길이
LECORDER_SPEECH_VAD_MIN_SILENCE_MS=300
# VAD 여유 길이
LECORDER_SPEECH_VAD_PADDING_MS=150

# ── 문서·OCR·업로드 ──
# vision / tesseract
LECORDER_OCR_ENGINE=vision
# 노트 업로드 파일 수
LECORDER_NOTE_MAX_FILES=500
# 노트 최대 페이지 수
LECORDER_NOTE_MAX_PAGES=500
# 노트 원본 합계 MB
LECORDER_NOTE_MAX_MB=100
# 녹음 조각 한 개의 최대 MB
LECORDER_RECORDING_CHUNK_MAX_MB=32

# ── LLM 검수와 백업 ──
# 검수 묶음 문자 수
LECORDER_REVIEW_BATCH_CHARS=1800
# 검수에 전달할 노트 문맥
LECORDER_REVIEW_CONTEXT_CHARS=6000
# 단어 수정 검수 출력 예산
LECORDER_REVIEW_EDIT_TOKENS=768
# 통합 검수 출력 예산
LECORDER_REVIEW_COMBINED_TOKENS=1024
# 수정 제안 최소 신뢰도
LECORDER_REVIEW_MIN_CONFIDENCE=0.8
# 백업 전 AI 요청 정리 제한 시간
LECORDER_BACKUP_QUIESCE_SECONDS=60.0

# ── 노트 해설·개요 생성 ──
# 첫 페이지 해설 생성 예산
LECORDER_NOTE_PAGE_TOKENS=2048
# 상세 해설 생성 예산
LECORDER_NOTE_DETAIL_TOKENS=3072
# 재생성 예산
LECORDER_NOTE_RETRY_TOKENS=4096
# 페이지 의미 검증 예산
LECORDER_NOTE_VALIDATION_TOKENS=4096
# 노트 생성 온도
LECORDER_NOTE_TEMPERATURE=0.2
# 개요 묶음 최대 항목 수
LECORDER_OVERVIEW_GROUP_ITEMS=4
# 개요 묶음 최대 문자 수
LECORDER_OVERVIEW_GROUP_CHARS=12000
# 개요 생성 예산
LECORDER_OVERVIEW_TOKENS=1536
# 개요 의미 검증 예산
LECORDER_OVERVIEW_VALIDATION_TOKENS=1024

# ── 용어집 선별·생성·검증 ──
# 후보 선별 묶음 문자 수
LECORDER_GLOSSARY_BATCH_CHARS=6000
# 후보 선별 출력 예산
LECORDER_GLOSSARY_SELECTION_TOKENS=1024
# 최종 용어집 생성 출력 예산
LECORDER_GLOSSARY_TOKENS=8192
# 용어집 의미 검증 출력 예산
LECORDER_GLOSSARY_VALIDATION_TOKENS=3072
